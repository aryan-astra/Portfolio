{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/content-check.mjs && node scripts/archive-check.mjs && next build && node scripts/postbuild.mjs && node scripts/site-check.mjs",
    "start": "npm run preview",
    "preview": "npm exec --yes --package=serve@14.2.4 -- serve out -l tcp://127.0.0.1:4173",
    "lint": "eslint",
    "test": "node --test scripts/*.test.mjs",
    "content:check": "node scripts/content-check.mjs",
    "content:sync": "node --env-file-if-exists=.env.local scripts/sync-notion.mjs",
    "archive:check": "node scripts/archive-check.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
